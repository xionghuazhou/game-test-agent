# ============================================================
# Game Test Agent configuration
# Copy this file to .env and fill in your own API key.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# Any OpenAI-compatible endpoint works (SiliconFlow, OpenAI,
# DeepSeek, local vLLM / Ollama, ...).
# ============================================================

# ===== LLM =====
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_MAX_TOKENS=4096

# ===== Database =====
DATABASE_URL=sqlite:///./data/game_test.db

# ===== App =====
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ===== Game automation =====
# demo   = built-in simulated RPG with planted bugs (runs out of the box)
# window = control a real game window via PyAutoGUI (pip install pyautogui)
GAME_MODE=demo
GAME_WINDOW_TITLE=Your Game Window Title
SCREENSHOT_DIR=./data/screenshots

# ===== Agent behavior =====
# Max test steps per task
MAX_STEPS=12
# Analyzer agent searches the web for evidence when unsure
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4